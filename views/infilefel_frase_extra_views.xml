<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="infilefel_frase_extra_view_list" model="ir.ui.view">
        <field name="name">infilefel.frase.extra.list</field>
        <field name="model">infilefel.frase.extra</field>
        <field name="arch" type="xml">
            <list string="Frases FEL">
                <field name="name"/>
                <field name="codigo_escenario"/>
                <field name="tipo_frase"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="infilefel_frase_extra_view_form" model="ir.ui.view">
        <field name="name">infilefel.frase.extra.form</field>
        <field name="model">infilefel.frase.extra</field>
        <field name="arch" type="xml">
            <form string="Frase FEL">
                <sheet>
                    <widget name="web_ribbon" title="Archivada" bg_color="text-bg-danger"
                            invisible="active"/>
                    <field name="active" invisible="1"/>
                    <group>
                        <field name="name" placeholder="Nombre para identificar la frase"/>
                        <field name="codigo_escenario"/>
                        <field name="tipo_frase"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="infilefel_frase_extra_view_search" model="ir.ui.view">
        <field name="name">infilefel.frase.extra.search</field>
        <field name="model">infilefel.frase.extra</field>
        <field name="arch" type="xml">
            <search string="Frases FEL">
                <field name="name"/>
                <field name="codigo_escenario"/>
                <field name="tipo_frase"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <filter name="archived" string="Archivadas" domain="[('active', '=', False)]"/>
                <separator/>
                <filter name="group_tipo" string="Tipo de frase" context="{'group_by': 'tipo_frase'}"/>
                <filter name="group_company" string="Compañía" context="{'group_by': 'company_id'}"
                        groups="base.group_multi_company"/>
            </search>
        </field>
    </record>

    <record id="infilefel_frase_extra_action" model="ir.actions.act_window">
        <field name="name">Frases FEL</field>
        <field name="res_model">infilefel.frase.extra</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="infilefel_frase_extra_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Cree una frase FEL adicional</p>
            <p>Seleccione estas frases como etiquetas en las facturas. Se suman a las frases del diario.</p>
        </field>
    </record>

    <menuitem id="infilefel_frase_extra_menu" name="Frases FEL"
              parent="account.menu_finance_configuration"
              action="infilefel_frase_extra_action"
              groups="account.group_account_manager" sequence="25"/>
</odoo>
